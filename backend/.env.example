# Copy this file to .env for local testing, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, etc.).
# NEVER commit a real .env file — it's already in .gitignore.

# Which AI provider to call, in its OpenAI-compatible chat-completions form.
# Google AI Studio (Gemini, free tier):
#   AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   AI_MODEL=gemini-2.0-flash
# Groq (free tier):
#   AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
#   AI_MODEL=llama-3.1-8b-instant
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.0-flash

# Your own API key from that provider. Never share this or commit it.
AI_API_KEY=

# The origin(s) allowed to call this backend, comma-separated if more than one.
# e.g. https://your-username.github.io
ALLOWED_ORIGIN=*

# Port the server listens on (most hosts set this automatically).
PORT=3000
